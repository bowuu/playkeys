{
  "manifest_version": 3,
  "name": "Playkeys for Plex Web",
  "short_name": "Playkeys",
  "version": "1.1.3",
  "minimum_chrome_version": "111",
  "description": "Global keyboard shortcuts, native squircle playback badge, and popup flyout controls for Plex Web and custom Plex servers.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://app.plex.tv/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Playkeys for Plex Web",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.plex.tv/*"
      ],
      "js": [
        "content/main-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://app.plex.tv/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "play_pause": {
      "suggested_key": {
        "default": "MediaPlayPause",
        "mac": "MediaPlayPause"
      },
      "description": "Play / Pause playback",
      "global": true
    },
    "next_track": {
      "suggested_key": {
        "default": "MediaNextTrack",
        "mac": "MediaNextTrack"
      },
      "description": "Next track",
      "global": true
    },
    "prev_track": {
      "suggested_key": {
        "default": "MediaPrevTrack",
        "mac": "MediaPrevTrack"
      },
      "description": "Previous track",
      "global": true
    },
    "stop_playback": {
      "suggested_key": {
        "default": "MediaStop",
        "mac": "MediaStop"
      },
      "description": "Stop playback",
      "global": true
    },
    "volume_up": {
      "description": "Volume up"
    },
    "volume_down": {
      "description": "Volume down"
    },
    "toggle_mute": {
      "description": "Toggle mute"
    }
  }
}
